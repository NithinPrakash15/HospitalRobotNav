<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hospital_robot_nav_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and parameter configurations for the autonomous hospital
    robot navigation platform (ROS 2).
  </description>
  <maintainer email="team@hospitalrobotnav.org">Hospital Robot Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hospital_robot_nav_nodes</exec_depend>
  <exec_depend>hospital_robot_nav_msgs</exec_depend>
  <exec_depend>hospital_robot_nav_core</exec_depend>
  <exec_depend>hospital_robot_nav_description</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>


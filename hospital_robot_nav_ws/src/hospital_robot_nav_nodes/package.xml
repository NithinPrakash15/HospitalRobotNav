<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hospital_robot_nav_nodes</name>
  <version>0.1.0</version>
  <description>
    ROS 2 nodes for the autonomous hospital robot navigation platform.
    Speech pipeline, NLU, dialogue, semantic map, planners, mission
    executor, fleet coordinator, and robot controller nodes.
  </description>
  <maintainer email="team@hospitalrobotnav.org">Hospital Robot Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>hospital_robot_nav_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

